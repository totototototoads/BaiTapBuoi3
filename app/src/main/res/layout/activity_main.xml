<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <!-- Block 1 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginBottom="12dp"
        android:background="@color/block_1_blue"
        android:gravity="center"
        android:text="@string/num_1"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Block 2 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginBottom="12dp"
        android:background="@color/block_2_red"
        android:gravity="center"
        android:text="@string/num_2"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Row with Blocks 3, 4, 5 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <!-- Block 3 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@color/block_3_yellow"
            android:gravity="center"
            android:text="@string/num_3"
            android:textColor="@color/black"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Block 4 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@color/block_4_green"
            android:gravity="center"
            android:text="@string/num_4"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Block 5 -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@color/block_5_purple"
            android:gravity="center"
            android:text="@string/num_5"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Empty Space / Column 4 -->
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Block 6 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/block_6_orange"
        android:gravity="center"
        android:text="@string/num_6"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Push student info to bottom -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Student Info at the bottom -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/student_info"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>